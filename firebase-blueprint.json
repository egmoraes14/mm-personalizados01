      "properties": {
        "descricao": { "type": "string" },
        "valorUnitario": { "type": "number" }
      },
      "required": ["descricao", "valorUnitario"]
    },
    "produtos": {
      "title": "Produtos",
      "description": "Produtos cadastrados e precificados",
